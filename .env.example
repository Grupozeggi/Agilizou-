# Copie para .env.local e preencha. Nunca commite o .env.local.

# URL pública do app (usada nos links dos e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon ou publishable). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role ou secret). SOMENTE servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (etapa 10)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# WhatsApp Cloud API (etapa 8)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# E-mail transacional dos lembretes (etapa 6)
RESEND_API_KEY=

# Apenas para os testes de RLS (Postgres local)
TEST_DATABASE_URL=

# Tarefas agendadas (Vercel Cron). Gere com: openssl rand -hex 32
CRON_SECRET=

# Notificações no celular (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@agilizou.app

# Remetente dos e-mails de aviso (domínio verificado no Resend)
EMAIL_REMETENTE=Agilizou <avisos@agilizou.app>

# WhatsApp: "simulado" (só log) ou "meta" (Cloud API real)
WHATSAPP_PROVEDOR=simulado
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=agilizou_lembrete
# Custo estimado por mensagem, em centavos (só para o painel)
WHATSAPP_CUSTO_CENTAVOS=5
