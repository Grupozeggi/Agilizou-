# Copie para .env.local (ou cadastre na Vercel) e preencha.
# NUNCA commite o .env.local. Só as variáveis NEXT_PUBLIC_ vão para o navegador.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://agilizou.app

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon ou publishable)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role ou secret). SOMENTE servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tarefas agendadas (Vercel Cron). Gere com: openssl rand -hex 32 ---
CRON_SECRET=

# --- Asaas (assinaturas) ---
# Sandbox: https://sandbox.asaas.com/api/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token configurado no webhook do Asaas (chega no cabeçalho asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# --- WhatsApp (Meta Cloud API) ---
# "simulado" (só registra no log) ou "meta" (envio real)
WHATSAPP_PROVEDOR=simulado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=agilizou_lembrete
# Custo estimado por mensagem, em centavos (só para o painel)
WHATSAPP_CUSTO_CENTAVOS=5

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_REMETENTE=Agilizou <avisos@agilizou.app>

# --- Notificações no celular (Web Push). Gere com: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@agilizou.app

# --- Somente para os testes de banco (Postgres local, nunca o de produção) ---
TEST_DATABASE_URL=
